# Copy to apps/web/.env.local (gitignored). Full env matrix: specs/06-infra-devex.md § Env matrix.
# Nothing is read yet in Milestone 0; values below are the local (non-Docker) defaults.

NEXT_PUBLIC_URL=http://localhost:3000

# Browser-facing CMS origin (includes CMS_BASE_PATH in prod, e.g. https://<site>/cms)
NEXT_PUBLIC_CMS_URL=http://localhost:3001
# Server-side CMS origin for SSR fetches (Docker: http://cms:3001, prod: http://cms:3001/cms)
CMS_INTERNAL_URL=

# Media (Milestone 3)
NEXT_PUBLIC_S3_PUBLIC_URL=
NEXT_IMAGE_UNOPTIMIZED=

# Analytics (Milestone 6). No default container id — leave empty to disable GTM.
NEXT_PUBLIC_GTM_ID=
