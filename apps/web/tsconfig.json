{
  "extends": "@autosearch/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-audit2/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
