# Copy to apps/cms/.env (gitignored). Full env matrix: specs/06-infra-devex.md § Env matrix.

# --- Required (validated at boot) ---
PAYLOAD_SECRET=change-me-dev-secret
DATABASE_URI=mongodb://127.0.0.1:27017/autosearch

# --- Optional ---
# Unset locally. Production serves the CMS under the site host: CMS_BASE_PATH=/cms
CMS_BASE_PATH=

# Public CMS origin (admin links / SEO generateURL). Include basePath in prod.
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# --- Milestone 3 — S3 / MinIO media (bucket autosearch-media) ---
# Leave blank for local disk uploads. Point at MinIO for S3-compatible storage.
# S3_BUCKET=autosearch-media
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_PUBLIC_URL=http://127.0.0.1:9000/autosearch-media
# S3_FORCE_PATH_STYLE=true
# S3_PRESIGN_ENDPOINT=
# S3_PRESIGN_EXPIRES_SECONDS=3600
# S3_ACL=
# MEDIA_PATH=

# --- Milestone 3 — revalidation webhook to the web app ---
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-revalidate-secret

# --- Milestone 3 — live preview / admin convenience ---
# AUTOLOGIN_EMAIL=dev@payloadcms.com
# AUTOLOGIN_PASSWORD=test

# Milestone 4 — optional lead notifications (specs/09-booking-and-leads.md)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# Staff Telegram bot (specs/12-telegram-bot.md). Same BOT_INTERNAL_SECRET as apps/bot/.env.
# BOT_INTERNAL_URL empty = skip notify (B5+). Secret required for /api/bot/* from B1.
BOT_INTERNAL_SECRET=change-me-bot-internal-secret
# BOT_INTERNAL_URL=http://127.0.0.1:3002

