{
  "name": "@autosearch/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./payload-types": "./src/payload-types.ts"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3001",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001 -H 0.0.0.0",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@autosearch/config": "workspace:*",
    "@payloadcms/db-mongodb": "3.83.0",
    "@payloadcms/next": "3.83.0",
    "@payloadcms/ui": "3.83.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "15.4.11",
    "payload": "3.83.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@autosearch/eslint-config": "workspace:*",
    "@autosearch/tsconfig": "workspace:*",
    "@types/node": "^20.17.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "eslint": "^9.17.0",
    "typescript": "5.7.3"
  }
}
