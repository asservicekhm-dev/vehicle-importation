{
  "name": "@autosearch/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./payload-types": "./src/payload-types-export.ts"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3001",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001 -H 0.0.0.0",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types && node ./scripts/export-payload-types.mjs",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:globals": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-globals.ts",
    "seed:globals:local-media": "cross-env NODE_OPTIONS=--no-deprecation S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= payload run src/scripts/seed-globals.ts",
    "seed:home": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-home.ts",
    "seed:home:local-media": "cross-env NODE_OPTIONS=--no-deprecation S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= payload run src/scripts/seed-home.ts",
    "seed:services": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-services.ts",
    "seed:services:local-media": "cross-env NODE_OPTIONS=--no-deprecation S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= payload run src/scripts/seed-services.ts",
    "seed:blog": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-blog.ts",
    "seed:blog:local-media": "cross-env NODE_OPTIONS=--no-deprecation S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= payload run src/scripts/seed-blog.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@autosearch/config": "workspace:*",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@payloadcms/db-mongodb": "3.83.0",
    "@payloadcms/next": "3.83.0",
    "@payloadcms/plugin-redirects": "3.83.0",
    "@payloadcms/plugin-seo": "3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@payloadcms/storage-s3": "3.83.0",
    "@payloadcms/ui": "3.83.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "15.4.11",
    "payload": "3.83.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sass": "^1.107.1",
    "sharp": "0.32.6",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@autosearch/eslint-config": "workspace:*",
    "@autosearch/tsconfig": "workspace:*",
    "@types/node": "^20.17.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "eslint": "^9.17.0",
    "typescript": "5.7.3"
  }
}
