# Copy to apps/bot/.env (gitignored).
# Product contract: specs/12-telegram-bot.md — build order: specs/13-telegram-bot-roadmap.md

# --- Required ---
# From @BotFather → /newbot → HTTP API token
TELEGRAM_BOT_TOKEN=

# Shared with CMS for /api/bot/* and /internal/* (generate a long random string)
BOT_INTERNAL_SECRET=change-me-bot-internal-secret

# --- Mode ---
# polling = local/dev (default). webhook = production (needs TELEGRAM_WEBHOOK_URL).
TELEGRAM_MODE=polling

# --- Optional (webhook / prod) ---
# TELEGRAM_WEBHOOK_URL=https://example.com/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret

# CMS origin for bot → Payload /api/bot/* (unused until B1+)
CMS_INTERNAL_URL=http://127.0.0.1:3001

# HTTP listen (health). Default 3002.
PORT=3002
HOST=0.0.0.0
