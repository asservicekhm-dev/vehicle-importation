# Production values for `.deploy/docker-compose.prod.yml`
# Copy to `env.web.prod` on the server (`setup.sh` does this once).
# Hosts must match `env.traefik.prod` (same subdomains, HTTPS in public URLs).

CMS_BASE_PATH=/cms
NEXT_PUBLIC_CMS_URL=https://example.com/cms
NEXT_PUBLIC_URL=https://example.com
# Leave empty to disable GTM (no default container id).
NEXT_PUBLIC_GTM_ID=
CMS_INTERNAL_URL=http://cms:3001/cms
PAYLOAD_FETCH_ALLOW_INSECURE_TLS=0

PAYLOAD_SECRET=change-me-use-long-random-secret
CMS_URL=https://example.com/cms
DATABASE_URI=mongodb://mongo:27017/autosearch
REVALIDATE_SECRET=change-me-revalidate-secret

S3_BUCKET=autosearch-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_PUBLIC_URL=https://s3.example.com/autosearch-media
S3_FORCE_PATH_STYLE=true
S3_ACL=public-read

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-secret
