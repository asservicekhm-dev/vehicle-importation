# Domains for Traefik labels (host only, no https://)

# Public site host (CMS is served at /cms on this host)
WEB_DOMAIN=example.com

# MinIO S3 API (container port 9000)
WEB_MINIO_S3_DOMAIN=s3.example.com

# MinIO web console (container port 9001)
WEB_MINIO_CONSOLE_DOMAIN=minio.example.com

# Let's Encrypt (required)
TRAEFIK_ACME_EMAIL=ops@example.com
