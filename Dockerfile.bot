# syntax=docker/dockerfile:1
# Production bot image (Telegram staff bot). Spec: specs/12-telegram-bot.md / 13 § B6.
FROM node:20-alpine AS base

FROM base AS builder
RUN apk add --no-cache libc6-compat
RUN apk update
WORKDIR /app
RUN npm install -g turbo
COPY . .
RUN turbo prune --scope=@autosearch/bot --docker

FROM base AS installer
RUN apk add --no-cache libc6-compat
RUN apk update
WORKDIR /app

COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN corepack enable
RUN pnpm install --frozen-lockfile

COPY --from=builder /app/out/full/ .

# Bypass Turbo so runtime env is not required at build time.
RUN pnpm --filter @autosearch/bot build

FROM base AS runner
WORKDIR /app

RUN apk add --no-cache wget

ENV NODE_ENV=production
ENV PORT=3002
ENV HOST=0.0.0.0

COPY --from=installer /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=installer /app/node_modules ./node_modules
COPY --from=installer /app/apps/bot ./apps/bot
COPY --from=installer /app/packages ./packages

WORKDIR /app/apps/bot

EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:3002/health" >/dev/null || exit 1

CMD ["node", "dist/index.js"]
