{
  "name": "autosearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:cms": "turbo dev --filter=@autosearch/cms",
    "dev:web": "turbo dev --filter=@autosearch/web",
    "dev:bot": "turbo dev --filter=@autosearch/bot",
    "build": "turbo build",
    "build:cms": "turbo build --filter=@autosearch/cms",
    "build:web": "turbo build --filter=@autosearch/web",
    "build:bot": "turbo build --filter=@autosearch/bot",
    "generate:types": "turbo generate:types",
    "seed:globals": "pnpm --filter @autosearch/cms seed:globals",
    "seed:globals:local-media": "pnpm --filter @autosearch/cms seed:globals:local-media",
    "seed:home": "pnpm --filter @autosearch/cms seed:home",
    "seed:home:local-media": "pnpm --filter @autosearch/cms seed:home:local-media",
    "seed:services": "pnpm --filter @autosearch/cms seed:services",
    "seed:services:local-media": "pnpm --filter @autosearch/cms seed:services:local-media",
    "seed:blog": "pnpm --filter @autosearch/cms seed:blog",
    "seed:blog:local-media": "pnpm --filter @autosearch/cms seed:blog:local-media",
    "seed:all": "pnpm seed:globals && pnpm seed:home && pnpm seed:services && pnpm seed:blog",
    "seed:all:local-media": "pnpm seed:globals:local-media && pnpm seed:home:local-media && pnpm seed:services:local-media && pnpm seed:blog:local-media",
    "seed": "node ./scripts/seed-area.mjs",
    "seed:backup": "node .deploy/seed/seed.mjs backup --env dev",
    "seed:restore": "node .deploy/seed/seed.mjs seed --env dev --yes",
    "seed:backup:prod": "node .deploy/seed/seed.mjs backup --env prod",
    "seed:restore:prod": "node .deploy/seed/seed.mjs seed --env prod --yes --confirm-prod",
    "new": "pnpm --filter @autosearch/web new",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "typecheck": "turbo typecheck",
    "format": "prettier . --check",
    "format:fix": "prettier . --write"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-css-order": "^2.1.2",
    "turbo": "^2.3.3",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^10"
  }
}
