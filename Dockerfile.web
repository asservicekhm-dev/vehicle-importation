# syntax=docker/dockerfile:1
# Production web image (Milestone 6). Spec: specs/06-infra-devex.md § Docker.
FROM node:20-alpine AS base

FROM base AS builder
RUN apk add --no-cache libc6-compat
RUN apk update
WORKDIR /app
RUN npm install -g turbo
COPY . .
RUN turbo prune --scope=@autosearch/web --docker

FROM base AS installer
RUN apk add --no-cache libc6-compat
RUN apk update
WORKDIR /app

COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY eslint.config.mjs ./eslint.config.mjs
RUN corepack enable
RUN pnpm install --frozen-lockfile

COPY --from=builder /app/out/full/ .

ARG NEXT_PUBLIC_CMS_URL
ARG NEXT_PUBLIC_S3_BROWSER_BASE
ARG NEXT_PUBLIC_S3_PUBLIC_URL
ARG NEXT_PUBLIC_URL
ARG NEXT_PUBLIC_GTM_ID
ARG PAYLOAD_FETCH_ALLOW_INSECURE_TLS
ENV NEXT_PUBLIC_CMS_URL=$NEXT_PUBLIC_CMS_URL
ENV NEXT_PUBLIC_S3_BROWSER_BASE=$NEXT_PUBLIC_S3_BROWSER_BASE
ENV NEXT_PUBLIC_S3_PUBLIC_URL=$NEXT_PUBLIC_S3_PUBLIC_URL
ENV NEXT_PUBLIC_URL=$NEXT_PUBLIC_URL
ENV NEXT_PUBLIC_GTM_ID=$NEXT_PUBLIC_GTM_ID
ENV PAYLOAD_FETCH_ALLOW_INSECURE_TLS=$PAYLOAD_FETCH_ALLOW_INSECURE_TLS

# Bypass Turbo so NEXT_PUBLIC_* ARGs are not stripped from `next build`.
RUN pnpm --filter @autosearch/web build

FROM base AS runner
WORKDIR /app

COPY --from=installer /app/apps/web/next.config.ts .
COPY --from=installer /app/apps/web/package.json .

COPY --from=installer /app/apps/web/.next/standalone ./
COPY --from=installer /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=installer /app/apps/web/public ./apps/web/public

ENV PORT=3000
ENV HOST=0.0.0.0
EXPOSE 3000

CMD node apps/web/server.js
