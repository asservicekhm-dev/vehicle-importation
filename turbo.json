{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "CMS_BASE_PATH",
    "NEXT_BASE_PATH",
    "NEXT_PUBLIC_CMS_URL",
    "NEXT_PUBLIC_URL",
    "NEXT_PUBLIC_GTM_ID",
    "NEXT_PUBLIC_S3_PUBLIC_URL",
    "NEXT_PUBLIC_S3_BROWSER_BASE",
    "NEXT_IMAGE_UNOPTIMIZED",
    "DISABLE_STANDALONE"
  ],
  "globalPassThroughEnv": [
    "PAYLOAD_SECRET",
    "DATABASE_URI",
    "CMS_INTERNAL_URL",
    "WATCHPACK_POLLING"
  ],
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "generate:types": {
      "cache": false
    },
    "lint": {},
    "typecheck": {}
  }
}
