{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "CMS_BASE_PATH",
    "NEXT_BASE_PATH",
    "NEXT_PUBLIC_CMS_URL",
    "NEXT_PUBLIC_URL",
    "NEXT_PUBLIC_GTM_ID",
    "NEXT_PUBLIC_S3_PUBLIC_URL",
    "NEXT_PUBLIC_S3_BROWSER_BASE",
    "NEXT_IMAGE_UNOPTIMIZED",
    "DISABLE_STANDALONE"
  ],
  "globalPassThroughEnv": [
    "PAYLOAD_SECRET",
    "DATABASE_URI",
    "CMS_INTERNAL_URL",
    "WEB_URL",
    "REVALIDATE_SECRET",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_PUBLIC_URL",
    "S3_FORCE_PATH_STYLE",
    "S3_PRESIGN_ENDPOINT",
    "S3_PRESIGN_EXPIRES_SECONDS",
    "S3_ACL",
    "MEDIA_PATH",
    "WATCHPACK_POLLING",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_MODE",
    "TELEGRAM_WEBHOOK_URL",
    "TELEGRAM_WEBHOOK_SECRET",
    "BOT_INTERNAL_SECRET",
    "BOT_INTERNAL_URL",
    "PORT",
    "HOST"
  ],
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "generate:types": {
      "cache": false
    },
    "lint": {},
    "typecheck": {}
  }
}
